{
  "manifest_version": 3,
  "name": "Reddit Misinformation Checker",
  "version": "0.5",
  "description": "Flags possible misinformation and shows sentiment for posts on the current Reddit page.",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"],
      "js": ["content.js"]
    }
  ]
}
